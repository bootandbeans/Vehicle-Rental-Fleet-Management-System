# Copy to `.env` and adjust if the defaults clash with something already running locally.
# docker compose picks the file up automatically.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=vpoptimizer
POSTGRES_USER=vpoptimizer
POSTGRES_PASSWORD=vpoptimizer
POSTGRES_PORT=5432

# --- Published ports --------------------------------------------------------
BACKEND_PORT=8080
FRONTEND_PORT=3000

# --- Backend ----------------------------------------------------------------
# Comma separated list of additional browser origins allowed to call the API directly.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
